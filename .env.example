# Written automatically by `npx convex dev` — do not fill these in by hand.
# Copy this file to .env.local only if you are wiring a second machine to an
# existing deployment.

# Public: the browser connects to this. Safe to expose.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Private: identifies the deployment to the Convex CLI. Never commit it.
CONVEX_DEPLOYMENT=dev:your-deployment
